# Set these in your hosting provider's environment settings, never in HTML or Git.
SITE_URL=https://nitecapcocktail.com
PAYSTACK_SECRET_KEY=
ORDER_DB=/data/orders.sqlite3
# Keep disabled until payment, fulfilment, and notification settings are tested.
CHECKOUT_ENABLED=false
# JSON array, e.g. [{"id":"pickup","label":"Pickup at <confirmed address>","fee_naira":0,"requires_address":false}]
FULFILMENT_OPTIONS=[{"id":"delivery","label":"Delivery — no delivery fee","fee_naira":0,"requires_address":true}]
# Generate a long random token for the private order dashboard.
ADMIN_TOKEN=
# Paid order alerts are delivered through your own SMTP service.
ORDER_NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
